	quests: [
		{
			description: [
				"Set sail with Eureka!, the ultimate ship-building mod. Unlike traditional boats, Eureka! lets you design and build your own vessel block by block. Whether it's a humble raft or a mighty galleon, your ship is fully yours."
				"Once you're done building, place a Ship Helm at the control point and right-click it to assemble your ship. From there, take the helm and sail across the ocean between the scattered islands of the world."
				"Master your vessel and become the terror—or hero—of the seas."
			]
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "smallships:item/ship/oak_dhow"
